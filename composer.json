{
    "name": "monitorhub/client",
    "description": "Reports exceptions and access logs from a Laravel app into the central MonitorHub app.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.1",
        "illuminate/bus": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/contracts": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/http": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/queue": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/support": "^10.0 || ^11.0 || ^12.0 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "CsnMonitor\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "CsnMonitor\\MonitorClientServiceProvider"
            ]
        }
    },
    "prefer-stable": true
}
