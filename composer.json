{
    "name": "csn/monitorhub-client",
    "description": "Reports exceptions and access logs from a Laravel app into the central MonitorHub app.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.1",
        "laravel/framework": "^10.0|^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "CsnMonitor\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "CsnMonitor\\MonitorClientServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}
